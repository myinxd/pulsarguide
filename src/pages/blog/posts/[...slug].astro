---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 系列导航：仅当文章属于某个系列时计算上篇/下篇
let seriesNav = null;
if (post.data.series) {
  const { key } = post.data.series;
  const siblings = (await getCollection('blog'))
    .filter((p) => !p.data.draft && p.data.series && p.data.series.key === key)
    .sort((a, b) => a.data.series.order - b.data.series.order);
  const idx = siblings.findIndex((p) => p.id === post.id);
  seriesNav = {
    title: post.data.series.title,
    key,
    prev: idx > 0 ? siblings[idx - 1] : null,
    next: idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null,
  };
}
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="post-content">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.updatedDate && (
          <span class="updated">
            · 更新于 {post.data.updatedDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
        )}
        <div class="post-tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
    </header>

    <div class="content-body">
      <Content />
    </div>

    {
      seriesNav && (
        <nav class="series-nav">
          <a href={`/blog/series/${seriesNav.key}`} class="series-nav-title">
            📚 {seriesNav.title}
          </a>
          <div class="series-nav-links">
            {seriesNav.prev ? (
              <a href={`/blog/posts/${seriesNav.prev.id}`} class="series-nav-item series-nav-prev">
                <span class="series-nav-label">← 上一篇</span>
                <span class="series-nav-post">{seriesNav.prev.data.title}</span>
              </a>
            ) : (
              <span class="series-nav-item series-nav-placeholder"></span>
            )}
            {seriesNav.next ? (
              <a href={`/blog/posts/${seriesNav.next.id}`} class="series-nav-item series-nav-next">
                <span class="series-nav-label">下一篇 →</span>
                <span class="series-nav-post">{seriesNav.next.data.title}</span>
              </a>
            ) : (
              <span class="series-nav-item series-nav-placeholder"></span>
            )}
          </div>
        </nav>
      )
    }
  </article>
</Layout>

<style>
  .post-header {
    padding: 2rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .updated {
    color: var(--text-muted);
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--accent-1);
  }

  .post-header h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    margin: 0;
  }

  .content-body {
    padding-bottom: 2rem;
  }

  .series-nav {
    margin-top: 1rem;
    padding: 1.2rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
  }

  .series-nav-title {
    display: inline-block;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
  }
  .series-nav-title:hover {
    color: var(--accent-2);
  }

  .series-nav-links {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .series-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 48%;
  }

  .series-nav-placeholder {
    max-width: 48%;
  }

  .series-nav-next {
    text-align: right;
    align-items: flex-end;
  }

  .series-nav-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .series-nav-post {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .series-nav-item:hover .series-nav-post {
    color: var(--accent-2);
  }
</style>
