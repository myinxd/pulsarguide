---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('paperNotes')).filter((note) => !note.data.draft && note.data.series);
  const seriesMap = new Map();
  for (const note of notes) {
    const key = note.data.series.key;
    if (!seriesMap.has(key)) {
      seriesMap.set(key, {
        key,
        title: note.data.series.title,
        notes: [],
      });
    }
    seriesMap.get(key).notes.push(note);
  }
  return Array.from(seriesMap.values()).map((s) => ({
    params: { key: s.key },
    props: {
      seriesTitle: s.title,
      seriesNotes: s.notes.sort((a, b) => a.data.series.order - b.data.series.order),
    },
  }));
}

const { key } = Astro.params;
const { seriesTitle, seriesNotes } = Astro.props;
---

<Layout title={`${seriesTitle} · 论文笔记`} description={`「${seriesTitle}」阅读线：论文精读与工程适用性判定`}>
  <section class="page-header">
    <h1>📚 {seriesTitle}</h1>
    <p>论文阅读线 · 共 {seriesNotes.length} 篇，按阅读顺序排列</p>
    <a href="/paper-notes/" class="back-link">← 全部论文笔记</a>
  </section>

  <section class="post-list">
    {
      seriesNotes.map((note, index) => (
        <article class="post-card">
          <a href={`/paper-notes/notes/${note.id}`} class="post-link">
            <div class="post-meta">
              <span class="series-index">第 {index + 1} 篇</span>
              <time datetime={note.data.pubDate.toISOString()}>
                {note.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <div class="post-tags">
                {note.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <h2 class="post-title">{note.data.title}</h2>
            <p class="post-desc">{note.data.description}</p>
            {note.data.paperUrl && <span class="paper-link">🔗 原论文 →</span>}
          </a>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .page-header {
    padding: 3rem 0 2rem;
  }
  .page-header h1 {
    margin: 0;
    font-size: 1.8rem;
  }
  .page-header p {
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }
  .back-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 4rem;
  }

  .post-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: all 0.2s;
  }
  .post-card:hover {
    border-color: rgba(100, 116, 139, 0.3);
    background: transparent;
  }

  .post-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .series-index {
    background: rgba(100, 116, 139, 0.12);
    border: 1px solid rgba(100, 116, 139, 0.25);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--accent-2, #0891b2);
    font-weight: 600;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    background: rgba(71, 85, 105, 0.1);
    border: 1px solid rgba(71, 85, 105, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--accent-1);
  }

  .post-title {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: var(--text-primary);
    transition: color 0.2s;
  }
  .post-card:hover .post-title {
    color: var(--accent-2);
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 0.5rem;
    line-height: 1.5;
  }

  .paper-link {
    font-size: 0.85rem;
    color: var(--accent-3);
  }
</style>
