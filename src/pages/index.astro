---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = [
  ...(await getCollection('blog')),
  ...(await getCollection('agent')),
  ...(await getCollection('paperNotes')),
];

const seriesMap = new Map();
for (const post of posts) {
  if (post.data.draft || !post.data.series) continue;
  const key = post.data.series.key;
  if (!seriesMap.has(key)) {
    seriesMap.set(key, {
      key,
      title: post.data.series.title,
      count: 0,
      collection: post.collection,
    });
  }
  const entry = seriesMap.get(key);
  if (entry) entry.count++;
}

const featuredKeys = ['diffusion-on-vehicle', 'e2e-driving-stack', 'agent-harness'];
const blurbs: Record<string, string> = {
  'diffusion-on-vehicle': '从 Flow Matching 到 DDIM，从 BF16 到车规芯片实时推理。',
  'e2e-driving-stack': '一段式端到端的工程真问题、注意力机制与导航选道。',
  'agent-harness': '从 harness 架构到 API 迁移，TL 岗加分的工程实践。',
};
const seriesHref = (s) =>
  s.collection === 'paperNotes' ? `/paper-notes/series/${s.key}/` : `/blog/series/${s.key}/`;

const featured = featuredKeys
  .map((key) => seriesMap.get(key))
  .filter(Boolean)
  .map((s) => ({ ...s, href: seriesHref(s), blurb: blurbs[s.key] }));

const others = [...seriesMap.values()]
  .filter((s) => !featuredKeys.includes(s.key))
  .sort((a, b) => b.count - a.count)
  .map((s) => ({ ...s, href: seriesHref(s) }));

const postHref = (post) => {
  if (post.collection === 'agent') return `/agent/posts/${post.id}`;
  if (post.collection === 'paperNotes') return `/paper-notes/notes/${post.id}`;
  return `/blog/posts/${post.id}`;
};
const recent = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    href: postHref(post),
    date: post.data.pubDate.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }),
    tags: post.data.tags.slice(0, 2),
  }));
---

<Layout>
  <section class="hero">
    <div class="hero-badge">
      <span class="badge-pulse"></span>
      <span class="badge-label">// 从射电望远镜到自动驾驶</span>
    </div>
    <h1 class="hero-title">
      <span class="gradient-text">Pulsar Guide</span>
      <span class="hero-sub">星导</span>
    </h1>
    <p class="hero-desc">
      一个前射电天文学者的自动驾驶技术博客。<br />
      记录论文阅读、工程实践，以及对感知与决策的思考。
    </p>
    <p class="hero-meta">$ research · perception · planning · est. 2026</p>
    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">浏览文章</a>
      <a href="/about" class="btn btn-outline">关于我</a>
    </div>
  </section>

  <section class="series-section">
    <div class="section-heading">
      <span class="section-kicker">// READING PATHS</span>
      <h2>按专栏读</h2>
      <p>散装文章是日志，专栏才是作品集。</p>
    </div>

    <div class="features">
      {
        featured.map((s, i) => (
          <a href={s.href} class="feature-card">
            <span class="feature-tag">[{String(i + 1).padStart(2, '0')}] · {s.count} 篇</span>
            <h3>{s.title}</h3>
            <p>{s.blurb}</p>
            <span class="feature-link">进入专栏 →</span>
          </a>
        ))
      }
    </div>

    <div class="other-series">
      <span class="other-label">更多系列</span>
      <div class="other-links">
        {
          others.map((s) => (
            <a href={s.href} class="series-pill">
              {s.title} <span class="pill-count">{s.count}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="recent-section">
    <div class="recent-head">
      <div>
        <span class="section-kicker">// LATEST</span>
        <h2>最近更新</h2>
      </div>
      <a href="/blog" class="recent-all">全部文章 →</a>
    </div>
    <div class="recent-list">
      {
        recent.map((post) => (
          <a href={post.href} class="recent-item">
            <time class="recent-date">{post.date}</time>
            <span class="recent-title">{post.title}</span>
            <span class="recent-tags">
              {post.tags.map((tag) => <span class="recent-tag">{tag}</span>)}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: 4rem 0 2.25rem;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(148, 163, 184, 0.18) 1px, transparent 1px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 72% 60% at 50% 38%, #000 30%, transparent 82%);
    mask-image: radial-gradient(ellipse 72% 60% at 50% 38%, #000 30%, transparent 82%);
    pointer-events: none;
    z-index: 0;
  }
  .hero > * {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.35);
    padding: 0.4rem 1rem;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .badge-pulse {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-1);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    font-size: 3.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--text-secondary), var(--text-muted));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero-desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 640px;
    margin: 0 auto 0.6rem;
  }

  .hero-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin: 0 auto 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.6rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--text-secondary), var(--text-muted));
    color: white;
    border: none;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(74, 85, 104, 0.25);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-primary);
  }
  .btn-outline:hover {
    border-color: var(--text-secondary);
    color: var(--text-secondary);
  }

  .section-heading {
    text-align: center;
    padding: 0.5rem 0 0;
  }
  .section-kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .section-heading h2 {
    margin: 0.4rem 0 0.3rem;
    font-size: 1.5rem;
  }
  .section-heading p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem 0 1.5rem;
  }

  @media (min-width: 1100px) {
    .features {
      grid-template-columns: repeat(3, 260px);
      justify-content: center;
    }
  }

  .feature-card {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--text-secondary);
    border-radius: 8px;
    padding: 1.6rem;
    transition: all 0.25s;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(74, 85, 104, 0.3);
    border-left-color: var(--text-primary);
    box-shadow: 0 4px 20px rgba(74, 85, 104, 0.1);
  }
  .feature-tag {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
  }

  .feature-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    transition: color 0.2s;
  }
  .feature-card:hover h3 {
    color: var(--accent-2);
  }

  .feature-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .feature-link {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .other-series {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    max-width: 900px;
    margin: 0 auto;
    padding: 1.2rem 0 4rem;
    border-top: 1px solid var(--border);
  }
  .other-label {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .other-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .series-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.82rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .series-pill:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }
  .pill-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .recent-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 0 4rem;
  }
  .recent-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .recent-head h2 {
    margin: 0.4rem 0 0;
    font-size: 1.3rem;
  }
  .recent-all {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .recent-all:hover {
    color: var(--text-primary);
  }
  .recent-list {
    border-top: 1px solid var(--border);
  }
  .recent-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: background 0.2s;
  }
  .recent-item:hover {
    background: var(--bg-secondary);
  }
  .recent-date {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .recent-title {
    flex: 1;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .recent-item:hover .recent-title {
    color: var(--accent-2);
  }
  .recent-tags {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .recent-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 0 2rem;
    }
    .hero-badge {
      font-size: 0.75rem;
      padding: 0.3rem 0.8rem;
    }
    .hero-title {
      flex-direction: row;
      justify-content: center;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .gradient-text {
      font-size: 1.8rem;
    }
    .hero-sub {
      font-size: 1rem;
    }
    .hero-desc {
      font-size: 0.95rem;
      line-height: 1.7;
      padding: 0 0.5rem;
    }
    .hero-meta {
      font-size: 0.72rem;
    }
    .hero-actions {
      flex-direction: column;
      gap: 0.75rem;
      padding: 0 1rem;
    }
    .btn {
      width: 100%;
      justify-content: center;
      padding: 0.8rem 1.6rem;
    }
    .features {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem 0 3rem;
    }
    .feature-card {
      padding: 1.5rem;
    }
    .other-series {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.2rem 1rem 3rem;
    }
    .recent-section {
      padding: 0 1rem 3rem;
    }
    .recent-item {
      gap: 0.6rem;
    }
    .recent-title {
      font-size: 0.9rem;
    }
    .recent-tags {
      display: none;
    }
  }
</style>
